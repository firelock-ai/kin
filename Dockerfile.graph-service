FROM node:22-slim AS base

WORKDIR /app

# Copy only the packages needed for graph-service
COPY packages/boundary-contracts ./packages/boundary-contracts
COPY packages/graph-service ./packages/graph-service

# No npm install needed — pure JS with no external deps (only file: references)

# Non-root user
RUN groupadd -r kin && useradd -r -g kin kin
USER kin

EXPOSE 4311

CMD ["node", "packages/graph-service/bin/kin-graph-service.js", "serve", "--repo", "/workspace", "--host", "0.0.0.0", "--port", "4311"]
