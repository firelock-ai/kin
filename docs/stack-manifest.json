{
  "version": 1,
  "organization": "firelock-ai",
  "rootDefault": "~/GitHub/kin-ecosystem",
  "profiles": {
    "core": {
      "description": "Local semantic substrate only",
      "repos": ["kin-db", "kin"]
    },
    "agent": {
      "description": "Core plus Kin-native agent runtime",
      "repos": ["kin-pilot"]
    },
    "editor": {
      "description": "Core plus editor surface and bundled bridge packages",
      "repos": ["kin-code"]
    },
    "product": {
      "description": "Core plus hosted collaboration surface",
      "repos": ["kinlab"]
    },
    "developer": {
      "description": "Core plus agent and editor surfaces",
      "extends": ["core", "agent", "editor"]
    },
    "full": {
      "description": "All primary developer and product repos",
      "extends": ["developer", "product"]
    }
  },
  "repos": [
    {
      "name": "kin-db",
      "role": "semantic-graph-database",
      "clone": "https://github.com/firelock-ai/kin-db.git",
      "dependsOn": [],
      "quickChecks": [["cargo", "test", "-p", "kin-db"]]
    },
    {
      "name": "kin",
      "role": "semantic-vcs-substrate",
      "clone": "https://github.com/firelock-ai/kin.git",
      "dependsOn": ["kin-db"],
      "env": {
        "KIN_REPO_PATH": "{workspace}",
        "KIN_BINARY_PATH": "{kin_binary}",
        "KIN_BOUNDARY_CONTRACTS_PATH": "{root}/kin/packages/boundary-contracts",
        "KIN_FS_ADAPTER_PATH": "{root}/kin/packages/fs-adapter/bin/kin-fs-adapter.js",
        "KIN_SCM_ADAPTER_PATH": "{root}/kin/packages/scm-adapter/bin/kin-scm-adapter.js",
        "KIN_GRAPH_SERVICE_PATH": "{root}/kin/packages/graph-service/bin/kin-graph-service.js"
      },
      "quickChecks": [
        ["cargo", "test", "-p", "kin-core", "-p", "kin-index", "-p", "kin-cli", "-p", "kin-integration-tests"],
        ["cargo", "run", "-p", "kin-daemon", "--bin", "kin-daemon", "--", "--help"]
      ]
    },
    {
      "name": "kin-pilot",
      "role": "agent-runtime",
      "clone": "https://github.com/firelock-ai/kin-pilot.git",
      "upstream": "https://github.com/openai/codex.git",
      "dependsOn": ["kin"],
      "env": {
        "KIN_BINARY_PATH": "{kin_binary}",
        "KIN_REPO_PATH": "{workspace}"
      },
      "quickChecks": [["cargo", "run", "--profile", "ci-test", "-p", "codex-cli", "--", "-C", "{workspace}", "--kin-summary"]],
      "cwd": "codex-rs"
    },
    {
      "name": "kin-code",
      "role": "editor-surface",
      "clone": "https://github.com/firelock-ai/kin-code.git",
      "upstream": "https://github.com/microsoft/vscode.git",
      "dependsOn": ["kin"],
      "env": {
        "KIN_CODE_PATH": "{root}/kin-code",
        "KIN_BINARY_PATH": "{kin_binary}"
      },
      "quickChecks": [["npm", "run", "test-kin-stack"]]
    },
    {
      "name": "kinlab",
      "role": "collaboration-surface",
      "clone": "https://github.com/firelock-ai/kinlab.git",
      "dependsOn": ["kin"],
      "env": {
        "KINLAB_PATH": "{root}/kinlab"
      },
      "quickChecks": [
        ["pnpm", "--filter", "@kinlab/control-plane", "test"],
        ["pnpm", "--filter", "@kinlab/control-plane", "typecheck"],
        ["pnpm", "--filter", "@kinlab/web", "typecheck"],
        ["pnpm", "--filter", "@kinlab/web", "test"]
      ]
    }
  ],
  "services": [
    {
      "name": "kin-daemon",
      "profiles": ["editor", "developer", "full"],
      "repo": "kin",
      "cwd": "{root}/kin",
      "command": [
        "cargo",
        "run",
        "-p",
        "kin-daemon",
        "--bin",
        "kin-daemon",
        "--",
        "--repo",
        "{workspace}",
        "--port",
        "4219"
      ],
      "env": {
        "KIN_REPO_PATH": "{workspace}"
      },
      "url": "http://127.0.0.1:4219/health"
    },
    {
      "name": "kin-graph-service",
      "profiles": ["editor", "developer", "full"],
      "repo": "kin",
      "cwd": "{root}/kin",
      "command": [
        "node",
        "{root}/kin/packages/graph-service/bin/kin-graph-service.js",
        "serve",
        "--repo",
        "{workspace}",
        "--host",
        "127.0.0.1",
        "--port",
        "4311",
        "--json-ready"
      ],
      "env": {
        "KIN_REPO_PATH": "{workspace}"
      },
      "url": "http://127.0.0.1:4311/health"
    },
    {
      "name": "kinlab-control-plane",
      "profiles": ["product", "full"],
      "repo": "kinlab",
      "cwd": "{root}/kinlab",
      "command": [
        "pnpm",
        "--filter",
        "@kinlab/control-plane",
        "exec",
        "tsx",
        "src/index.ts"
      ],
      "env": {
        "KIN_REPO_PATH": "{workspace}",
        "KIN_DISCOVERY_ROOT": "/tmp/kin-migrations",
        "KIN_BINARY_PATH": "{kin_binary}",
        "PORT": "4010",
        "KIN_ENABLE_DEV_AUTH_SESSION": "1"
      },
      "url": "http://127.0.0.1:4010/api/health"
    },
    {
      "name": "kinlab-web",
      "profiles": ["product", "full"],
      "repo": "kinlab",
      "cwd": "{root}/kinlab",
      "command": [
        "bash",
        "{root}/kin-stack/scripts/start-kinlab-web.sh",
        "{root}/kinlab",
        "127.0.0.1",
        "5173"
      ],
      "env": {
        "VITE_API_BASE_URL": "http://127.0.0.1:4010"
      },
      "url": "http://127.0.0.1:5173"
    }
  ],
  "links": [
    ["kin-db", "kin", "backs graph storage and search"],
    ["kin", "kin-pilot", "semantic agent surface"],
    ["kin", "kin-code", "bundled fs/scm/graph packages back the editor surface"],
    ["kin", "kinlab", "hosted control-plane substrate plus shared bundled boundary logic"]
  ]
}
