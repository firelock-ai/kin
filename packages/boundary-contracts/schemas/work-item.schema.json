{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/work-item",
  "description": "A work item anchored to semantic scopes in the code graph.",
  "type": "object",
  "required": ["work_id", "kind", "title", "description", "status", "priority", "scopes", "acceptance_criteria", "external_refs", "created_by", "created_at"],
  "properties": {
    "work_id": { "type": "string" },
    "kind": { "type": "string", "enum": ["Feature", "Task", "Issue", "Debt", "Todo", "Investigation"] },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "status": { "type": "string", "enum": ["Proposed", "Planned", "InProgress", "Blocked", "Done", "Verified", "Archived"] },
    "priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low", "None"] },
    "scopes": { "type": "array", "items": { "type": "object" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string" } },
    "external_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["system", "identifier"],
        "properties": {
          "system": { "type": "string" },
          "identifier": { "type": "string" },
          "url": { "type": ["string", "null"] }
        }
      }
    },
    "created_by": {
      "type": "object",
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["Human", "Assistant"] }
      }
    },
    "created_at": { "type": "string", "description": "ISO 8601 UTC timestamp" }
  }
}
