{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/scm-context",
  "type": "object",
  "required": ["repoRoot", "repoName", "mode", "kinPath"],
  "properties": {
    "repoRoot": { "type": "string" },
    "repoName": { "type": "string" },
    "mode": { "type": "string", "enum": ["compat", "native"] },
    "kinPath": { "type": ["string", "null"] }
  }
}
