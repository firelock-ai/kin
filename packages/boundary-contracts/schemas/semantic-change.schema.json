{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/semantic-change",
  "description": "An atomic semantic change in Kin's DAG. Contains entity deltas, relation deltas, artifact deltas, and risk summary.",
  "type": "object",
  "required": ["id", "message", "author", "timestamp", "parents", "entity_deltas", "relation_deltas", "artifact_deltas", "evidence", "projected_files"],
  "properties": {
    "id": { "$ref": "kin://contracts/hash256" },
    "message": { "type": "string" },
    "author": { "type": "string" },
    "timestamp": { "type": "string", "description": "ISO 8601 UTC timestamp" },
    "parents": { "type": "array", "items": { "$ref": "kin://contracts/hash256" } },
    "authored_on": { "type": ["string", "null"], "description": "Branch name at creation time" },
    "entity_deltas": { "type": "array", "items": { "type": "object" } },
    "relation_deltas": { "type": "array", "items": { "type": "object" } },
    "artifact_deltas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file_id", "kind"],
        "properties": {
          "file_id": { "type": "string" },
          "kind": { "type": "string", "enum": ["Added", "Modified", "Removed"] },
          "old_hash": { "oneOf": [{ "$ref": "kin://contracts/hash256" }, { "type": "null" }] },
          "new_hash": { "oneOf": [{ "$ref": "kin://contracts/hash256" }, { "type": "null" }] }
        }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "projected_files": { "type": "array", "items": { "type": "string" } },
    "risk_summary": {
      "oneOf": [
        {
          "type": "object",
          "required": ["overall_risk", "breaking_changes", "contract_violations", "test_coverage_gaps", "work_risks", "notes"],
          "properties": {
            "overall_risk": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
            "breaking_changes": { "type": "array", "items": { "type": "string" } },
            "contract_violations": { "type": "array", "items": { "type": "string" } },
            "test_coverage_gaps": { "type": "array", "items": { "type": "string" } },
            "work_risks": { "type": "array", "items": { "type": "string" } },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        { "type": "null" }
      ]
    },
    "spec_link": { "type": ["string", "null"] }
  }
}
