{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/file-stat",
  "type": "object",
  "required": ["type", "ctimeMs", "mtimeMs", "size"],
  "properties": {
    "type": { "type": "string", "enum": ["file", "directory"] },
    "ctimeMs": { "type": "number" },
    "mtimeMs": { "type": "number" },
    "size": { "type": "number" }
  }
}
