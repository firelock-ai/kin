{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/vfs-protocol",
  "description": "Wire protocol types for VFS shim-daemon communication. MessagePack-serialized over Unix socket.",
  "definitions": {
    "vfs-request": {
      "description": "Request from VFS shim to daemon.",
      "oneOf": [
        { "type": "object", "required": ["Stat"], "properties": { "Stat": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" } } } } },
        { "type": "object", "required": ["ReadDir"], "properties": { "ReadDir": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" } } } } },
        { "type": "object", "required": ["Read"], "properties": { "Read": { "type": "object", "required": ["path", "offset", "len"], "properties": { "path": { "type": "string" }, "offset": { "type": "integer" }, "len": { "type": "integer" } } } } },
        { "type": "object", "required": ["ReadLink"], "properties": { "ReadLink": { "type": "object", "required": ["path"], "properties": { "path": { "type": "string" } } } } },
        { "type": "object", "required": ["Access"], "properties": { "Access": { "type": "object", "required": ["path", "mode"], "properties": { "path": { "type": "string" }, "mode": { "type": "integer" } } } } },
        { "type": "string", "const": "Ping" },
        { "type": "string", "const": "Subscribe" }
      ]
    },
    "vfs-response": {
      "description": "Response from daemon to VFS shim.",
      "oneOf": [
        { "type": "object", "required": ["Stat"], "properties": { "Stat": { "type": "object" } } },
        { "type": "object", "required": ["DirEntries"], "properties": { "DirEntries": { "type": "array" } } },
        { "type": "object", "required": ["Content"], "properties": { "Content": { "type": "object", "required": ["data", "total_size"], "properties": { "data": { "type": "array" }, "total_size": { "type": "integer" } } } } },
        { "type": "object", "required": ["LinkTarget"], "properties": { "LinkTarget": { "type": "string" } } },
        { "type": "object", "required": ["Accessible"], "properties": { "Accessible": { "type": "boolean" } } },
        { "type": "string", "const": "Pong" },
        { "type": "object", "required": ["Error"], "properties": { "Error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string", "enum": ["NotFound", "PermissionDenied", "IsDirectory", "NotDirectory", "IoError", "Internal"] }, "message": { "type": "string" } } } } },
        { "type": "object", "required": ["Invalidate"], "properties": { "Invalidate": { "type": "object", "required": ["paths"], "properties": { "paths": { "type": "array", "items": { "type": "string" } } } } } }
      ]
    },
    "vfs-protocol-version": {
      "description": "Current VFS wire protocol version.",
      "const": 1
    }
  }
}
