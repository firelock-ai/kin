{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/source-span",
  "description": "Source location of an entity within a file.",
  "type": "object",
  "required": ["file", "start_byte", "end_byte", "start_line", "end_line", "start_col", "end_col"],
  "properties": {
    "file": { "type": "string" },
    "start_byte": { "type": "integer" },
    "end_byte": { "type": "integer" },
    "start_line": { "type": "integer" },
    "end_line": { "type": "integer" },
    "start_col": { "type": "integer" },
    "end_col": { "type": "integer" }
  }
}
