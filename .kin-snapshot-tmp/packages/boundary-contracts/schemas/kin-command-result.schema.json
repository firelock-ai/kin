{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/kin-command-result",
  "type": "object",
  "required": ["ok", "command", "args", "stdout", "stderr"],
  "properties": {
    "ok": { "type": "boolean" },
    "command": { "type": ["string", "null"] },
    "args": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stdout": { "type": "string" },
    "stderr": { "type": "string" }
  }
}
