{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kin://contracts/scm-resource-groups",
  "type": "object",
  "required": ["ok", "groups"],
  "properties": {
    "ok": { "type": "boolean" },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "items"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "description", "tooltip"],
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "description": { "type": "string" },
                "tooltip": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
