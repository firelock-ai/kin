+
+            // Between the members of an object type a '<' opens the type
+            // parameters of a generic call signature, so the member before it
+            // has already ended:
+            //
+            //   interface I {
+            //     p: string
+            //     <T>(): void
+            //   }
+            //
+            // which is how TypeScript itself reads it. Everywhere else a '<'
+            // continues the line, as in `a\n< b`. TYPE_MEMBER_AUTOMATIC_SEMICOLON
+            // is never returned; the grammar makes it valid only at an object
+            // type member boundary, so its validity is the question being
+            // asked, the same way FUNCTION_SIGNATURE_AUTOMATIC_SEMICOLON is read
+            // above rather than returned.
+        case '<':
+            if (!valid_symbols[TYPE_MEMBER_AUTOMATIC_SEMICOLON]) {
+                return false;
+            }
+            break;
 
