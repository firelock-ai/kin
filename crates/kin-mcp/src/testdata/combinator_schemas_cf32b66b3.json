   {
    "if": {
     "required": [
      "request_id"
     ]
    },
    "then": {
     "properties": {
      "scope": {
       "const": "repository"
      }
     },
     "propertyNames": {
      "enum": [
       "operations",
       "session_id",
       "scope",
       "request_id",
       "summary"
      ]
     },
     "required": [
      "session_id"
     ]
    }
   }
  ],
  "properties": {
   "operations": {
    "type": "array"
   },
   "request_id": {
    "type": "string"
   },
   "scope": {
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "operations"
  ],
  "type": "object"
 },
