#
# systemd unit file for kin-daemon
#
# Install:
#   sudo cp kin-daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kin-daemon
#
# Or per-user:
#   cp kin-daemon.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now kin-daemon

[Unit]
Description=Kin semantic VCS background daemon
Documentation=https://github.com/firelock-ai/kin
After=network.target

[Service]
Type=simple
ExecStart=%h/.kin/bin/kin daemon start
Restart=on-failure
RestartSec=5
Environment=RUST_LOG=info
WorkingDirectory=%h

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.kin
PrivateTmp=true

[Install]
WantedBy=default.target
