<!--
  launchd plist template for kin-daemon (per-repo).

  This is a TEMPLATE for explicit, per-repository host integration. The Kin
  CLI does not install or remove it during `kin init` or `kin eject`.

  Before installing, replace REPO_ID, DAEMON_BIN, REPO_PATH, and PORT with
  repository-specific values. DAEMON_BIN and REPO_PATH must be absolute.

  Manual install (single repo):
    cp ai.firelock.kin-daemon.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/ai.firelock.kin-daemon.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.firelock.kin-daemon.REPO_ID</string>

    <key>ProgramArguments</key>
    <array>
        <string>DAEMON_BIN</string>
        <string>--repo</string>
        <string>REPO_PATH</string>
        <string>--port</string>
        <string>PORT</string>
    </array>

    <key>KeepAlive</key>
    <true/>

    <key>RunAtLoad</key>
    <true/>

    <key>ProcessType</key>
    <string>Background</string>

    <key>StandardOutPath</key>
    <string>/tmp/kin-daemon-REPO_ID.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/kin-daemon-REPO_ID.stderr.log</string>
</dict>
</plist>
